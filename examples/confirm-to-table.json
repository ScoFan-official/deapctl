{
  "meta": {
    "desc": "把确认过的任务清单 JSON 批量写入任务分工表，每条任务一行",
    "examples": ["确认入表", "把这些任务写进分工表"]
  },
  "params": [
    {"name": "任务清单JSON", "desc": "拆解产出的任务清单 JSON 文本", "required": true, "type": "文本"},
    {"name": "默认执行人", "desc": "任务未指明负责人时的兜底", "required": false, "type": "文本"}
  ],
  "nodes": [
    {
      "type": "llm",
      "model": "通义千问3.0-max",
      "question_vars": ["任务清单JSON", "默认执行人"],
      "prompt": "你是任务解析器。将问题中的任务清单 JSON 逐条解析为结构化字段。\n规则：\n1. 今天日期以系统变量为准，相对时间（本周五/下周二/明天）必须换算为具体日期。\n2. 负责人缺失时用默认执行人，仍无则留空。\n3. 只输出 JSON，不要解释。",
      "json_mode": "{\"任务清单\":[{\"任务标题\":\"\",\"任务内容\":\"\",\"负责人\":\"\",\"截止日期\":\"2025-01-01 18:00\",\"优先级\":\"中\",\"来源需求\":\"\",\"依据\":\"\"}]}"
    },
    {
      "type": "loop",
      "array": "任务清单",
      "children": [
        {
          "type": "llm",
          "model": "通义千问3.0-max",
          "question_vars": ["本次循环数据"],
          "prompt": "把单条任务对象拆成字段：任务标题、任务内容、负责人姓名、截止日期、优先级、依据。逐字提取不改写。",
          "outputs": [
            {"name": "任务标题", "type": "文本"},
            {"name": "任务内容", "type": "文本"},
            {"name": "负责人", "type": "文本"},
            {"name": "截止日期", "type": "日期时间"},
            {"name": "优先级", "type": "文本"},
            {"name": "依据", "type": "文本"}
          ]
        },
        {
          "type": "record",
          "base": "实验室秘书试点",
          "table": "任务分工",
          "fields": {"目标": "任务标题", "截止日期": "截止日期"},
          "fixed": {"状态": "待认领", "优先级": "中"}
        }
      ]
    },
    {"type": "end", "pairs": [{"name": "写入任务清单", "var": "任务清单"}]}
  ]
}
